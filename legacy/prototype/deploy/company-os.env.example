# /etc/company-os.env  (chmod 600, owned by root; read by systemd for loops + dashboard)
COS_ROOT=/srv/sahabat-warga/company-os
WORKSPACE_DIR=/srv/sahabat-warga

# Read-only data sources for the loops
PROM_URL=http://127.0.0.1:9090
REPLICA_DATABASE_URL=postgres://cos_readonly:CHANGE_ME@127.0.0.1:5432/sahabat_warga?sslmode=disable
# Fine-grained GitHub token: issues + pull requests (read/write), contents (read/write) on app repos. No admin.
GH_TOKEN=github_pat_CHANGE_ME
GITHUB_TOKEN=${GH_TOKEN}

# Dashboard
COS_DASHBOARD_TOKEN=CHANGE_ME_long_random_string
COS_DASHBOARD_HOST=127.0.0.1
COS_DASHBOARD_PORT=8787
# COS_COOKIE_SECURE=1          # set when served over HTTPS (Traefik)

# Optional: POST JSON on failures / new proposals / DOWN status (Hermes webhook, ntfy, Slack, etc.)
# COS_NOTIFY_WEBHOOK=https://...

# Only for loops using the "claude-api" harness (billed per token, capped by daily_api_cost_cap_usd)
# ANTHROPIC_API_KEY=sk-ant-...
