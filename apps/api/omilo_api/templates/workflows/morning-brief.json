{
  "name": "Morning brief",
  "category": "Operations",
  "icon": "ri-sun-line",
  "description": "Every weekday morning your Chief of Staff writes a short brief of yesterday and today, and puts it in your Inbox.",
  "graph": {
    "nodes": [
      {
        "id": "cron",
        "type": "trigger.schedule",
        "label": "Weekdays 8:45",
        "note": "",
        "config": {
          "cron": "45 8 * * 1-5"
        },
        "x": 0,
        "y": 0
      },
      {
        "id": "brief",
        "type": "ai.helper",
        "label": "Chief writes the brief",
        "note": "",
        "config": {
          "staff_id": "@chief",
          "brief": "Write my morning brief: what got done yesterday, what's planned today, anything waiting on me. Five bullets at most.",
          "wait": true
        },
        "x": 0,
        "y": 150
      },
      {
        "id": "tell",
        "type": "omilo.inbox",
        "label": "Put it in my Inbox",
        "note": "",
        "config": {
          "title": "Morning brief",
          "body": "{{ steps.brief.output.report | default:'' }}"
        },
        "x": 0,
        "y": 300
      }
    ],
    "edges": [
      {
        "from": "cron",
        "port": "out",
        "to": "brief"
      },
      {
        "from": "brief",
        "port": "out",
        "to": "tell"
      }
    ]
  },
  "needs": [],
  "by": "Omilo"
}