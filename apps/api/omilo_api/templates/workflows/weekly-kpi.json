{
  "name": "Weekly KPI from an API",
  "category": "Finance",
  "icon": "ri-line-chart-line",
  "description": "Every Monday, read a number from an API (Stripe, Plausible, your backend) and save it as a KPI on the Company page.",
  "graph": {
    "nodes": [
      {
        "id": "cron",
        "type": "trigger.schedule",
        "label": "Mondays 9:00",
        "note": "",
        "config": {
          "cron": "0 9 * * 1"
        },
        "x": 0,
        "y": 0
      },
      {
        "id": "get",
        "type": "app.http",
        "label": "Read the number",
        "note": "Point it at your API.",
        "config": {
          "method": "GET",
          "url": "https://api.example.com/stats",
          "headers": {}
        },
        "x": 0,
        "y": 150
      },
      {
        "id": "kpi",
        "type": "omilo.kpi",
        "label": "Save the KPI",
        "note": "",
        "config": {
          "name": "revenue",
          "value": "{{ steps.get.output.data.total }}",
          "period": "{{ now }}",
          "source": "workflow"
        },
        "x": 0,
        "y": 300
      }
    ],
    "edges": [
      {
        "from": "cron",
        "port": "out",
        "to": "get"
      },
      {
        "from": "get",
        "port": "out",
        "to": "kpi"
      }
    ]
  },
  "needs": [],
  "by": "Omilo"
}