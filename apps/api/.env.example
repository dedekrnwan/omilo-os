DATABASE_URL=postgresql+psycopg://omilo:omilo@localhost:5432/omilo
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_S=3600
ENV=development

# Where emailed links (password reset, invites) point the user.
FRONTEND_BASE=http://localhost:5173

# ── Transactional email (SMTP) ───────────────────────────────────────────────
# Required for email verification, magic-code sign-in, password reset, invites,
# and two-step codes. Point these at any SMTP relay (Resend, SendGrid, Mailgun,
# Postmark, SES, Gmail, …). Without SMTP_HOST those endpoints return 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@omilo.app
SMTP_FROM_NAME=Omilo
# STARTTLS on 587 (default). For implicit TLS on 465: SMTP_STARTTLS=false SMTP_SSL=true
SMTP_STARTTLS=true
SMTP_SSL=false

# ── Notification emails (approval, alert, welcome, waitlist, weekly digest) ──
# Needs SMTP above. NOTIFY_LOOP runs due weekly digests every 5 min inside the
# API; set it false and run `omilo-notify` from cron instead if you prefer.
# NOTIFY_ENABLED=false
# NOTIFY_LOOP=true
# SITE_URL=https://omilo.saga.co.id
