{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omilo",
  "version": "0.4.0",
  "identifier": "id.co.saga.omilo",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Your office of AI helpers",
    "longDescription": "Omilo is the office between a founder and their AI staff. This app runs the whole thing on your Mac: the office, its database and its helpers.",
    "copyright": "Omilo contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": {
      "../../../dist/runtime/": "runtime/",
      "icons/tray.png": "tray.png",
      "icons/tray@2x.png": "tray@2x.png"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true,
      "dmg": {
        "windowSize": { "width": 600, "height": 380 },
        "appPosition": { "x": 160, "y": 190 },
        "applicationFolderPosition": { "x": 440, "y": 190 }
      }
    }
  }
}
