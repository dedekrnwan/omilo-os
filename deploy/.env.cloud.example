# deploy/.env.cloud.example — environment for the CLOUD CONTROL PLANE stack.
# Copy this file to .env.cloud and fill in real values.
# DO NOT commit .env.cloud — it contains secrets.
#
# Usage:
#   cp deploy/.env.cloud.example .env.cloud
#   # edit .env.cloud
#   docker compose -f deploy/docker-compose.cloud.yml --env-file .env.cloud up -d

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=omilo
POSTGRES_USER=omilo
POSTGRES_PASSWORD=change-me-strong-password

# Full DSN (overrides the default constructed from POSTGRES_* above if set).
# Leave blank to use the default: postgresql+psycopg://omilo:<password>@postgres:5432/omilo
DATABASE_URL=

# ── JWT signing ───────────────────────────────────────────────────────────────
# Cloud/control-plane SHOULD use RS256 (OMILO_JWT_PRIVATE_KEY) so local runtimes
# can verify tokens via the cloud JWKS endpoint offline — no shared secret needed.
# If using HS256 instead, JWT_SECRET MUST be a strong random value — NEVER the default.
#
# JWT_SECRET — REQUIRED (even when using RS256; compose fails fast if empty).
# Generate a strong value: openssl rand -hex 32
JWT_SECRET=
#
# RS256 private key in PEM format (PKCS8) — RECOMMENDED for cloud deployments.
# Generate with:
#   openssl genrsa -out jwt_private.pem 2048
#   openssl pkcs8 -topk8 -nocrypt -in jwt_private.pem -out jwt_private_pkcs8.pem
# Then paste the content (including -----BEGIN PRIVATE KEY----- header) or:
#   OMILO_JWT_PRIVATE_KEY="$(cat jwt_private_pkcs8.pem)"
OMILO_JWT_PRIVATE_KEY=

# ── Cloud plugin + payments ───────────────────────────────────────────────────
# A cloud plugin supplies the plans/prices and the payment gateway
# (python module exposing plugin(); see apps/api/omilo/cloud_plugin.py).
# Leave empty for a non-billed deployment (only the free self-hosted plan).
OMILO_CLOUD_PLUGIN=
OMILO_PAYMENT_PROVIDER=manual
