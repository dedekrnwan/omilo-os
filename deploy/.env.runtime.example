# deploy/.env.runtime.example — environment for the self-host runtime stack.
#
# LOCAL MODE (default — no cloud env needed):
#   Just run: docker compose -f deploy/docker-compose.runtime.yml up -d
#   No OMILO_CONTROL_PLANE_URL or OMILO_INSTALL_TOKEN required.
#   BYO AI keys (set in the UI), fully offline-capable, pooled inference disabled.
#
# HYBRID MODE (cloud identity + pooled credits):
#   Run: omilo connect   (or: npx omilo connect)
#   The connect flow signs you in to the Omilo cloud, issues an install token,
#   and writes OMILO_MODE=hybrid + the cloud vars into this file, then restarts.
#   Alternatively: fill in the vars below manually and restart the stack.
#
# DO NOT commit this file once it contains an install token.
#
# Usage (local — no copy needed):
#   docker compose -f deploy/docker-compose.runtime.yml up -d
#
# Usage (hybrid, after filling in vars below):
#   cp deploy/.env.runtime.example deploy/.env.runtime
#   # edit deploy/.env.runtime to set OMILO_MODE=hybrid + URL + token
#   docker compose -f deploy/docker-compose.runtime.yml --env-file deploy/.env.runtime up -d

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=omilo
POSTGRES_USER=omilo
POSTGRES_PASSWORD=change-me-strong-password

# Full DSN (overrides the individual vars above if set).
DATABASE_URL=

# ── Run mode ──────────────────────────────────────────────────────────────────
# local   — default; privacy-first, no cloud required. BYO AI keys only.
# hybrid  — cloud identity + pooled credits; data stays local.
# (Leave unset or set to "local" to run without any cloud env.)
OMILO_MODE=local

# ── Cloud control plane (hybrid mode only) ────────────────────────────────────
# Required only when OMILO_MODE=hybrid.
# URL of the Omilo cloud control plane (default: https://api.omilo.app).
# Change only if you are running your own control plane.
OMILO_CONTROL_PLANE_URL=

# Install token issued by `omilo connect` (or `omilo-connect` inside the api
# container). Leave blank in local mode.
OMILO_INSTALL_TOKEN=
