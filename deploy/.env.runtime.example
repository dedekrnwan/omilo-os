# deploy/.env.runtime.example — environment for the LOCAL RUNTIME (self-host) stack.
# Copy this file to .env.runtime and fill in your install token.
# DO NOT commit .env.runtime — it contains your install token.
#
# Usage:
#   cp deploy/.env.runtime.example .env.runtime
#   # Start the stack first (install token not yet required):
#   docker compose -f deploy/docker-compose.runtime.yml --env-file .env.runtime up -d
#   # Register your runtime with the cloud (sign in to Omilo first):
#   docker compose -f deploy/docker-compose.runtime.yml exec api omilo-register
#   # Copy the printed install token into .env.runtime, then restart:
#   docker compose -f deploy/docker-compose.runtime.yml --env-file .env.runtime up -d

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_DB=omilo
POSTGRES_USER=omilo
POSTGRES_PASSWORD=change-me-strong-password

# Full DSN (overrides the default if set).
DATABASE_URL=

# ── Cloud control plane ───────────────────────────────────────────────────────
# URL of the Omilo cloud control plane. Default: https://api.omilo.app
# Change only if you are running your own control plane.
OMILO_CONTROL_PLANE_URL=https://api.omilo.app

# Install token issued by `omilo-register` during first-run registration.
# Leave blank on first start; fill in after running omilo-register.
OMILO_INSTALL_TOKEN=
