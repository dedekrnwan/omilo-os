# Copy to deploy/.env and fill in.
POSTGRES_PASSWORD=change-me
SAGA_SECRET_KEY=generate-with-openssl-rand-hex-32
SAGA_PUBLIC_URL=https://os.example.com
SAGA_TIMEZONE=Asia/Jakarta
# SAGA_BASE_PATH=/os            # only when served under a path prefix (the web image must be built with NEXT_PUBLIC_BASE_PATH=/os)
# ANTHROPIC_API_KEY=...         # optional: a Claude API key for every company (each can also set its own in Settings → AI)
# Existing Traefik:
# TRAEFIK_ENABLE=true
# TRAEFIK_RULE=Host(`os.example.com`)
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERTRESOLVER=letsencrypt
