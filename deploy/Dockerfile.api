# deploy/Dockerfile.api — ONE image for both OMILO_MODE=cloud and OMILO_MODE=runtime.
# Build context: repo root (so deploy/start-api.sh and apps/api/ are both reachable)
#   docker build -f deploy/Dockerfile.api -t omilo-api .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Install build dependencies needed by psycopg (libpq) and cryptography
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy the package and install it (production; no dev extras)
COPY apps/api/pyproject.toml ./
COPY apps/api/omilo ./omilo

RUN pip install --no-cache-dir .

# Entrypoint — single source of truth; see deploy/start-api.sh
COPY deploy/start-api.sh /usr/local/bin/start-api.sh
RUN chmod +x /usr/local/bin/start-api.sh

# Create a non-root user to run the API
RUN useradd -r -u 10001 -g root omilo

USER omilo

EXPOSE 8000

CMD ["/usr/local/bin/start-api.sh"]
