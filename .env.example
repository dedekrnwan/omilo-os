# ── omilo-v2 environment variables ──────────────────────────────────────────
#
# Copy this file to .env.local and fill in the values.
# Never commit .env.local — it is listed in .gitignore.

# Set to "1" to switch the ReposProvider from mock data to the real HTTP backend.
# When unset (default), the app runs entirely against the mock fixtures so it
# works without a backend.
VITE_USE_HTTP=

# Base URL of the omilo backend API (no trailing slash).
# Only used when VITE_USE_HTTP=1.
VITE_API_URL=http://localhost:8000
